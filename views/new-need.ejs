<%- include('partials/header') %>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="auth-page">
  <div class="auth-card">
    <h1>Nova Necessidade</h1>
    <p class="subtitle">Descreva o que você precisa</p>

    <form method="POST" action="/needs">
      <div class="form-group">
        <label for="title">Título *</label>
        <input type="text" id="title" name="title" required placeholder="Ex: Ajuda com currículo">
      </div>

      <div class="form-group">
        <label for="description">Descrição</label>
        <textarea id="description" name="description" rows="4" placeholder="Conte mais detalhes sobre o que precisa..."></textarea>
      </div>

      <div class="form-group">
        <label for="category">Categoria</label>
        <select id="category" name="category">
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>"><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="requester_name">Seu nome (para contato)</label>
        <input type="text" id="requester_name" name="requester_name" value="<%= user.name %>">
      </div>

      <div class="form-group">
        <label for="requester_phone">WhatsApp para contato</label>
        <input type="text" id="requester_phone" name="requester_phone" placeholder="(11) 99999-9999">
      </div>

      <button type="submit" class="btn btn-primary btn-full">Publicar Necessidade</button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
