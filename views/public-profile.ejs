<%- include('partials/header') %>
<div class="profile-page">
  <div class="profile-card">
    <div class="profile-header">
      <div class="profile-avatar <%= profile.photo_url ? 'avatar-img' : '' %>"<%= profile.photo_url ? ` style="background-image:url('${profile.photo_url}')"` : '' %>><%= profile.photo_url ? '' : profile.name.charAt(0) %></div>
      <div>
        <h1><%= profile.name %></h1>
        <div class="social-links">
          <% if (profile.linkedin) { %><a href="<%= socialUrl('linkedin', profile.linkedin) %>" target="_blank" rel="noopener" class="social-chip">in LinkedIn</a><% } %>
          <% if (profile.instagram) { %><a href="<%= socialUrl('instagram', profile.instagram) %>" target="_blank" rel="noopener" class="social-chip">📷 Instagram</a><% } %>
          <% if (profile.x) { %><a href="<%= socialUrl('x', profile.x) %>" target="_blank" rel="noopener" class="social-chip">𝕏</a><% } %>
          <% if (profile.substack) { %><a href="<%= socialUrl('substack', profile.substack) %>" target="_blank" rel="noopener" class="social-chip">📰 Substack</a><% } %>
        </div>
      </div>
    </div>

    <% if (profile.bio) { %>
      <div class="profile-section">
        <h3>Sobre</h3>
        <p><%= profile.bio %></p>
      </div>
    <% } %>

    <% if (profile.skills && profile.skills.length) { %>
      <div class="profile-section">
        <h3>Habilidades</h3>
        <div class="tags">
          <% profile.skills.forEach(skill => { %>
            <span class="tag tag-blue"><%= skill %></span>
          <% }) %>
        </div>
      </div>
    <% } %>

    <% if (profile.help_categories && profile.help_categories.length) { %>
      <div class="profile-section">
        <h3>Categorias que pode ajudar</h3>
        <div class="tags">
          <% profile.help_categories.forEach(cat => { %>
            <span class="tag tag-green"><%= cat %></span>
          <% }) %>
        </div>
      </div>
    <% } %>

    <% const comps = clocCompetencies(profile.cloc_competencies); %>
    <% if (comps.length) { %>
      <div class="profile-section">
        <h3>🧭 Competências na mandala da CLOC</h3>
        <%- include('partials/mandala-wheel', { selectedKeys: profile.cloc_competencies }) %>
        <div class="mandala-chips">
          <% comps.forEach(c => { %>
            <span class="mandala-chip" title="<%= c.desc %>">
              <strong><%= c.nome %></strong>
              <em><%= c.en %></em>
            </span>
          <% }) %>
        </div>
      </div>
    <% } %>

    <a href="/needs" class="btn btn-primary">Ver Necessidades</a>
  </div>
</div>
<%- include('partials/footer') %>
