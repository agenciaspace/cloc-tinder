<%- include('partials/header') %>
<% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% const canSeeRequester = userIsRequester || isAdmin; %>

<div class="need-detail">
  <a href="/needs" class="btn btn-sm btn-secondary">← Voltar</a>

  <div class="need-detail-card">
    <div class="need-detail-header">
      <span class="tag tag-<%= need.category %>"><%= need.category %></span>
      <span class="tag tag-<%= need.status %>"><%= need.status %></span>
    </div>

    <h1><%= need.title %></h1>

    <% if (need.description) { %>
      <p class="need-detail-desc"><%= need.description %></p>
    <% } %>

    <div class="need-detail-meta">
      <p>
        <strong>Solicitante:</strong>
        <% if (canSeeRequester) { %>
          <%= need.requester_name || 'Membro do CLOC' %>
        <% } else { %>
          Membro do CLOC <span class="tag tag-sm tag-gray">🔒 anônimo</span>
        <% } %>
      </p>
      <% if (canSeeRequester && need.requester_phone) { %>
        <p><strong>Contato:</strong> <%= need.requester_phone %></p>
      <% } %>
      <p><strong>Data:</strong> <%= new Date(need.created_at).toLocaleDateString('pt-BR') %></p>
      <p><strong>Fonte:</strong> <%= need.source === 'whatsapp' ? 'Grupo WhatsApp' : 'App' %></p>
    </div>

    <div class="need-detail-actions">
      <% if (userIsRequester) { %>
        <% if (need.status === 'open') { %>
          <form method="POST" action="/needs/<%= need.id %>/close" style="display:inline">
            <button type="submit" class="btn btn-danger">Fechar Necessidade</button>
          </form>
        <% } else { %>
          <p class="status-closed">Esta necessidade foi <%= need.status === 'matched' ? 'atendida' : 'fechada' %>.</p>
        <% } %>

      <% } else if (myMatch && myMatch.status === 'accepted') { %>
        <div class="contact-revealed">
          ✅ <strong>Match aceito!</strong> Fale com o solicitante:
          <a class="btn btn-sm btn-primary" target="_blank" rel="noopener" href="<%= waLink(myMatch.requester_whatsapp) %>">💬 WhatsApp</a>
        </div>

      <% } else if (myMatch && myMatch.status === 'rejected') { %>
        <p class="status-closed">Sua oferta não foi aceita desta vez. Continue ajudando! 🙌</p>

      <% } else if (need.status === 'open') { %>
        <% if (alreadyMatched) { %>
          <p class="already-offered">Você já se ofereceu — aguardando o solicitante aceitar. O contato é liberado quando ele aceitar.</p>
        <% } else { %>
          <form method="POST" action="/matches/<%= need.id %>/offer">
            <button type="submit" class="btn btn-primary btn-lg">🤝 Oferecer Ajuda</button>
          </form>
        <% } %>
      <% } else { %>
        <p class="status-closed">Esta necessidade foi <%= need.status === 'matched' ? 'atendida' : 'fechada' %>.</p>
      <% } %>
    </div>
  </div>

  <%# Dono: ofertas recebidas, com aceitar/recusar e contato quando aceito %>
  <% if (userIsRequester) { %>
    <div class="card" style="margin-top: 24px;">
      <div class="card-header"><h2>🤝 Ofertas de ajuda<% if (offers.length) { %> (<%= offers.length %>)<% } %></h2></div>
      <div class="card-body">
        <% if (!offers.length) { %>
          <p class="empty-state">Ainda ninguém se ofereceu. Assim que alguém oferecer, aparece aqui pra você aceitar.</p>
        <% } else { %>
          <div class="helpers-list">
            <% offers.forEach(o => { %>
              <div class="helper-item">
                <div class="helper-avatar <%= o.helper_photo ? 'avatar-img' : '' %>"<%= o.helper_photo ? ` style="background-image:url('${o.helper_photo}')"` : '' %>><%= o.helper_photo ? '' : (o.helper_name || '?').charAt(0) %></div>
                <div class="helper-info">
                  <strong><%= o.helper_name %></strong>
                  <div class="tags">
                    <% (o.helper_skills || []).slice(0, 3).forEach(s => { %><span class="tag tag-sm tag-blue"><%= s %></span><% }) %>
                  </div>
                  <% if (o.status === 'accepted') { %>
                    <div class="contact-revealed" style="margin-top:8px">
                      ✅ Aceito —
                      <a class="btn btn-sm btn-primary" target="_blank" rel="noopener" href="<%= waLink(o.helper_phone) %>">💬 WhatsApp</a>
                    </div>
                  <% } %>
                </div>
                <div class="row-actions">
                  <% if (o.status === 'pending' && need.status === 'open') { %>
                    <form method="POST" action="/matches/<%= o.id %>/accept"><button class="btn btn-sm btn-primary">✓ Aceitar</button></form>
                    <form method="POST" action="/matches/<%= o.id %>/reject"><button class="btn btn-sm btn-danger">✕ Recusar</button></form>
                  <% } else if (o.status === 'rejected') { %>
                    <span class="tag tag-gray">recusado</span>
                  <% } %>
                  <a href="/user/<%= o.helper_id %>" class="btn btn-sm btn-secondary">Perfil</a>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <%# Sugestão de membros que combinam — categoria de ajuda + mandala da CLOC %>
  <% if (canSeeRequester && need.status === 'open') {
       const offeredIds = new Set((offers || []).map(o => o.helper_id));
       const suggestions = (helpers || []).filter(h => !offeredIds.has(h.id)).slice(0, 12);
       const REASON = {
         categoria: 'combina pela categoria',
         mandala: 'afinidade pela mandala',
         ambos: 'categoria + mandala',
         todas: 'ajuda em todas as áreas',
       };
  %>
    <div class="card" style="margin-top: 24px;">
      <div class="card-header"><h2>✨ Quem pode ajudar<% if (suggestions.length) { %> (<%= suggestions.length %>)<% } %></h2></div>
      <div class="card-body">
        <% if (!suggestions.length) { %>
          <p class="empty-state">Ainda não encontramos membros que combinem com essa categoria. Compartilhe no grupo pra alcançar mais gente! 🙌</p>
        <% } else { %>
          <p class="suggestions-hint">Membros disponíveis ordenados por relevância — pela categoria da necessidade e/ou pela mandala da CLOC.</p>
          <div class="helpers-list">
            <% suggestions.forEach(h => { const hc = clocCompetencies(h.cloc_competencies); %>
              <div class="helper-item">
                <div class="helper-avatar <%= h.photo_url ? 'avatar-img' : '' %>"<%= h.photo_url ? ` style="background-image:url('${h.photo_url}')"` : '' %>><%= h.photo_url ? '' : (h.name || '?').charAt(0) %></div>
                <div class="helper-info">
                  <strong><%= h.name %></strong>
                  <span class="match-badge match-<%= h.matchVia %>"><%= REASON[h.matchVia] || 'combina' %></span>
                  <% if ((h.skills || []).length || hc.length) { %>
                    <div class="tags">
                      <% (h.skills || []).slice(0, 3).forEach(s => { %><span class="tag tag-sm tag-blue"><%= s %></span><% }) %>
                      <% hc.slice(0, 3).forEach(c => { %><span class="tag tag-sm tag-coral"><%= c.nome %></span><% }) %>
                    </div>
                  <% } %>
                </div>
                <div class="row-actions">
                  <a href="/user/<%= h.id %>" class="btn btn-sm btn-secondary">Ver perfil</a>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>
</div>
<%- include('partials/footer') %>
