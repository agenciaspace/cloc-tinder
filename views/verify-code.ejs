<%- include('partials/header') %>
<div class="auth-page">
  <div class="auth-card verify-card">
    <div class="verify-badge">📲</div>
    <h1>Confirme seu número</h1>
    <p class="subtitle">
      Enviamos um código de <%= codeLength %> dígitos para o seu WhatsApp
      <strong><%= maskedPhone %></strong>.
    </p>

    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="POST" action="/register/verify">
      <div class="form-group">
        <label for="code">Código de verificação</label>
        <input
          type="text" id="code" name="code"
          class="code-input"
          inputmode="numeric" autocomplete="one-time-code"
          pattern="[0-9]*" maxlength="<%= codeLength %>"
          placeholder="<%= '•'.repeat(codeLength) %>"
          required autofocus>
      </div>
      <button type="submit" class="btn btn-primary btn-full btn-lg">Verificar e concluir</button>
    </form>

    <form method="POST" action="/register/resend" class="resend-form">
      <p class="auth-link">
        Não recebeu? <button type="submit" class="link-btn">Reenviar código</button>
        <span class="resend-hint">(disponível a cada <%= cooldown %>s)</span>
      </p>
    </form>

    <p class="auth-link"><a href="/register">← Usar outro número</a></p>
  </div>
</div>
<script>
  // Aceita apenas dígitos no campo de código.
  const codeEl = document.getElementById('code');
  codeEl.addEventListener('input', () => {
    codeEl.value = codeEl.value.replace(/\D+/g, '');
  });
</script>
<%- include('partials/footer') %>
