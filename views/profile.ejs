<%- include('partials/header') %>
<% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="profile-page">
  <div class="onboarding-card">
    <h2>👋 Como funciona o CLOC-Tinder</h2>
    <p class="onboarding-sub">Complete seu perfil abaixo para começar a dar e receber ajuda.</p>
    <%- include('partials/how-it-works', { compact: true }) %>
  </div>

  <div class="profile-card">
    <div class="profile-header">
      <div class="profile-avatar <%= profile.photo_url ? 'avatar-img' : '' %>"<%= profile.photo_url ? ` style="background-image:url('${profile.photo_url}')"` : '' %>><%= profile.photo_url ? '' : profile.name.charAt(0) %></div>
      <div>
        <h1><%= profile.name %></h1>
        <p><%= profile.email %></p>
      </div>
    </div>

    <form method="POST" action="/profile" enctype="multipart/form-data">
      <div class="form-group photo-field">
        <label for="photo">Foto de perfil</label>
        <div class="photo-upload">
          <span class="photo-preview <%= profile.photo_url ? 'has-img' : '' %>" id="photoPreview"<%= profile.photo_url ? ` style="background-image:url('${profile.photo_url}')"` : '' %>><%= profile.photo_url ? '' : '🙂' %></span>
          <label class="photo-btn" for="photo"><%= profile.photo_url ? 'Trocar foto' : 'Escolher foto' %></label>
          <input type="file" id="photo" name="photo" accept="image/png,image/jpeg,image/webp" hidden>
          <span class="photo-name" id="photoName">PNG, JPG ou WEBP · até 5MB</span>
        </div>
      </div>
      <div class="form-group">
        <label for="name">Nome</label>
        <input type="text" id="name" name="name" value="<%= profile.name %>" required>
      </div>
      <%- include('partials/social-fields', { s: profile }) %>

      <div class="form-group">
        <label for="phone">WhatsApp</label>
        <input type="text" id="phone" name="phone" value="<%= profile.phone || '' %>" placeholder="(11) 99999-9999">
      </div>

      <div class="form-group">
        <label for="bio">Bio / Sobre você</label>
        <textarea id="bio" name="bio" rows="3" placeholder="Conte um pouco sobre você e como pode ajudar..."><%= profile.bio || '' %></textarea>
      </div>

      <div class="form-group">
        <label for="skills">Habilidades (separadas por vírgula)</label>
        <input type="text" id="skills" name="skills" value="<%= profile.skills ? profile.skills.join(', ') : '' %>" placeholder="ex: JavaScript, Design, Fotografia">
      </div>

      <div class="form-group">
        <label>Áreas em que pode ajudar <span class="req">*</span>
          <span class="cat-counter" id="catCounter">0 selecionadas</span>
        </label>
        <small class="field-hint">Escolha <strong>pelo menos 3</strong> — é assim que a gente te conecta às necessidades certas.</small>
        <div class="checkbox-grid" id="catGrid">
          <% categories.forEach(cat => { %>
            <label class="checkbox-label">
              <input type="checkbox" name="help_categories" value="<%= cat %>"
                <%= profile.help_categories && profile.help_categories.includes(cat) ? 'checked' : '' %>>
              <%= cat.charAt(0).toUpperCase() + cat.slice(1) %>
            </label>
          <% }) %>
        </div>
      </div>

      <div class="form-group">
        <label>Disponibilidade</label>
        <div class="toggle-group">
          <label class="toggle-label">
            <input type="checkbox" name="can_help" value="1" <%= profile.can_help ? 'checked' : '' %>>
            Quero ajudar outras pessoas
          </label>
          <label class="toggle-label">
            <input type="checkbox" name="needs_help" value="1" <%= profile.needs_help ? 'checked' : '' %>>
            Estou precisando de ajuda
          </label>
        </div>
      </div>

      <button type="submit" class="btn btn-primary">Salvar Perfil</button>
    </form>
  </div>
</div>
<script>
  // Contador de áreas + exige pelo menos 3 ao enviar.
  (function () {
    const grid = document.getElementById('catGrid');
    const counter = document.getElementById('catCounter');
    const form = grid ? grid.closest('form') : null;
    if (!grid || !form) return;
    const boxes = () => [...grid.querySelectorAll('input[type=checkbox]')];
    function update() {
      const n = boxes().filter(b => b.checked).length;
      counter.textContent = n + ' selecionada' + (n === 1 ? '' : 's');
      counter.classList.toggle('ok', n >= 3);
    }
    grid.addEventListener('change', update);
    form.addEventListener('submit', (e) => {
      if (boxes().filter(b => b.checked).length < 3) {
        e.preventDefault();
        update();
        counter.classList.add('warn');
        grid.scrollIntoView({ behavior: 'smooth', block: 'center' });
        alert('Selecione pelo menos 3 áreas em que você pode ajudar.');
      }
    });
    update();
  })();

  const photoInput = document.getElementById('photo');
  if (photoInput) photoInput.addEventListener('change', () => {
    const file = photoInput.files[0]; if (!file) return;
    document.getElementById('photoName').textContent = file.name;
    const reader = new FileReader();
    reader.onload = e => {
      const prev = document.getElementById('photoPreview');
      prev.style.backgroundImage = `url(${e.target.result})`;
      prev.classList.add('has-img'); prev.textContent = '';
    };
    reader.readAsDataURL(file);
  });
</script>
<%- include('partials/footer') %>
