<%- include('partials/header') %>
<% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="profile-page">
  <div class="profile-card">
    <div class="profile-header">
      <div class="profile-avatar <%= profile.photo_url ? 'avatar-img' : '' %>"<%= profile.photo_url ? ` style="background-image:url('${profile.photo_url}')"` : '' %>><%= profile.photo_url ? '' : profile.name.charAt(0) %></div>
      <div>
        <h1><%= profile.name %></h1>
        <p><%= profile.email %></p>
      </div>
    </div>

    <form method="POST" action="/profile">
      <div class="form-group">
        <label for="name">Nome</label>
        <input type="text" id="name" name="name" value="<%= profile.name %>" required>
      </div>

      <div class="form-group">
        <label for="phone">WhatsApp</label>
        <input type="text" id="phone" name="phone" value="<%= profile.phone || '' %>" placeholder="(11) 99999-9999">
      </div>

      <div class="form-group">
        <label for="bio">Bio / Sobre você</label>
        <textarea id="bio" name="bio" rows="3" placeholder="Conte um pouco sobre você e como pode ajudar..."><%= profile.bio || '' %></textarea>
      </div>

      <div class="form-group">
        <label for="skills">Habilidades (separadas por vírgula)</label>
        <input type="text" id="skills" name="skills" value="<%= profile.skills ? profile.skills.join(', ') : '' %>" placeholder="ex: JavaScript, Design, Fotografia">
      </div>

      <div class="form-group">
        <label>Categorias onde pode ajudar</label>
        <div class="checkbox-grid">
          <% categories.forEach(cat => { %>
            <label class="checkbox-label">
              <input type="checkbox" name="help_categories" value="<%= cat %>"
                <%= profile.help_categories && profile.help_categories.includes(cat) ? 'checked' : '' %>>
              <%= cat.charAt(0).toUpperCase() + cat.slice(1) %>
            </label>
          <% }) %>
        </div>
      </div>

      <div class="form-group">
        <label>Disponibilidade</label>
        <div class="toggle-group">
          <label class="toggle-label">
            <input type="checkbox" name="can_help" value="1" <%= profile.can_help ? 'checked' : '' %>>
            Quero ajudar outras pessoas
          </label>
          <label class="toggle-label">
            <input type="checkbox" name="needs_help" value="1" <%= profile.needs_help ? 'checked' : '' %>>
            Estou precisando de ajuda
          </label>
        </div>
      </div>

      <button type="submit" class="btn btn-primary">Salvar Perfil</button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
