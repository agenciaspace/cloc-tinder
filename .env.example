# Copie para .env e preencha. NUNCA comite o .env (está no .gitignore).

# ===== Integração WhatsApp (uazapi) =====
# Host da sua instância uazapi (sem barra no final)
UAZAPI_BASE_URL=https://sua-instancia.uazapi.com
# Token da instância (vai no header "token")
UAZAPI_TOKEN=
# JID do grupo. Rode `npm run wa:groups` para descobrir.
UAZAPI_GROUP_JID=

# ===== Sincronização da lista de membros (apenas execução local) =====
WA_SYNC_INTERVAL_HORAS=6

# ===== Verificação por código (OTP) =====
OTP_LENGTH=6
OTP_TTL_MINUTOS=10
OTP_MAX_TENTATIVAS=5
OTP_REENVIO_COOLDOWN_SEG=60

# ===== UX / Admin =====
WA_GROUP_NAME=CLOC Brasil - Bate papo
# Link de convite do grupo (mostrado na tela de erro). Opcional.
WA_GROUP_INVITE_LINK=
# Email do super-admin (acesso garantido ao painel)
ADMIN_EMAIL=
# Super-admins por telefone (opcional, separados por vírgula)
ADMIN_PHONES=

# ===== Supabase (banco) =====
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Sessão e Cron =====
# String longa e aleatória para assinar o cookie de sessão
SESSION_SECRET=
# Segredo do Vercel Cron (a Vercel envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# ===== App =====
PORT=3001
