# ===== Supabase (banco) =====
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ===== Sessão / Cron =====
# Gere com: openssl rand -hex 24
SESSION_SECRET=troque-por-um-segredo-aleatorio
CRON_SECRET=troque-por-um-segredo-aleatorio

# ===== Integração WhatsApp (uazapi) =====
UAZAPI_BASE_URL=https://sua-instancia.uazapi.com
UAZAPI_TOKEN=seu-token-aqui
UAZAPI_GROUP_JID=1203xxxxxxxxxxxxx@g.us

# ===== Sincronização da lista de membros =====
WA_SYNC_INTERVAL_HORAS=6

# ===== Verificação por código (OTP) =====
OTP_LENGTH=6
OTP_TTL_MINUTOS=10
OTP_MAX_TENTATIVAS=5
OTP_REENVIO_COOLDOWN_SEG=60

# ===== UX / Admin =====
WA_GROUP_NAME=CLOC Brasil - Bate papo
WA_GROUP_INVITE_LINK=
# Admins: por email e/ou por telefones (lista separada por vírgula)
ADMIN_EMAIL=leonhatori@gmail.com
ADMIN_PHONES=
